# Copie a terraform.tfvars y rellene. Ese archivo NO se versiona.

ip_administracion = "SU.IP.PUBLICA/32"   # obtenga la suya con: curl ifconfig.me
nombre_llave_ssh  = ""                    # nombre de un key pair de EC2, o vacío

# Endpoint DIRECTO de Neon (sin -pooler)
database_url = "postgresql://usuario:clave@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

frontend_urls = "https://su-front.vercel.app,https://su-front-*.vercel.app"
