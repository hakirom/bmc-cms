#!/bin/bash
set -euxo pipefail
exec > >(tee /var/log/arranque-bmc.log) 2>&1

# --- Memoria de intercambio -------------------------------------------------
# La t3.micro tiene 1 GB. Aunque la imagen ya viene compilada, Strapi consume
# por encima de eso al arrancar y sin swap el proceso muere.
dd if=/dev/zero of=/swapfile bs=1M count=2048
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo '/swapfile none swap sw 0 0' >> /etc/fstab

# --- Docker -----------------------------------------------------------------
dnf update -y
dnf install -y docker awscli-2 || dnf install -y docker
systemctl enable --now docker

# --- Variables de entorno ---------------------------------------------------
# Fuera del contenedor y con permisos restringidos: no viajan en la imagen.
mkdir -p /etc/bmc
cat > /etc/bmc/cms.env <<'ENVFILE'
NODE_ENV=production
HOST=0.0.0.0
PORT=1337
APP_KEYS=${app_keys}
API_TOKEN_SALT=${api_token_salt}
ADMIN_JWT_SECRET=${admin_jwt}
JWT_SECRET=${jwt}
TRANSFER_TOKEN_SALT=${transfer_salt}
ENCRYPTION_KEY=${encryption_key}
DATABASE_CLIENT=postgres
DATABASE_URL=${database_url}
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=5
FRONTEND_URLS=${frontend_urls}
ENVFILE
chmod 600 /etc/bmc/cms.env

# --- Servicio ---------------------------------------------------------------
# systemd gestiona el contenedor: se autentica en ECR, descarga la imagen más
# reciente y la ejecuta. Al reiniciar la instancia vuelve solo.
cat > /usr/local/bin/bmc-cms-run.sh <<'RUNNER'
#!/bin/bash
set -euo pipefail
REGION="${region}"
IMAGEN="${imagen}"

aws ecr get-login-password --region "$REGION" \
  | docker login --username AWS --password-stdin "$${IMAGEN%%/*}"

docker pull "$IMAGEN"
docker rm -f bmc-cms 2>/dev/null || true

exec docker run --rm --name bmc-cms \
  --env-file /etc/bmc/cms.env \
  -p 1337:1337 \
  "$IMAGEN"
RUNNER
chmod +x /usr/local/bin/bmc-cms-run.sh

cat > /etc/systemd/system/bmc-cms.service <<'UNIT'
[Unit]
Description=BMC CMS (Strapi en contenedor)
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/bmc-cms-run.sh
ExecStop=/usr/bin/docker stop bmc-cms
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now bmc-cms
