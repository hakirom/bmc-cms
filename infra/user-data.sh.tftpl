#!/bin/bash
set -euxo pipefail
exec > >(tee /var/log/arranque-bmc.log) 2>&1

# --- Memoria de intercambio -------------------------------------------------
# La t3.micro tiene 1 GB y la compilación del panel de Strapi no cabe: sin esto
# el build muere sin explicar la causa.
dd if=/dev/zero of=/swapfile bs=1M count=2048
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo '/swapfile none swap sw 0 0' >> /etc/fstab

# --- Dependencias -----------------------------------------------------------
dnf update -y
dnf install -y git
curl -fsSL https://rpm.nodesource.com/setup_22.x | bash -
dnf install -y nodejs

# --- Código -----------------------------------------------------------------
cd /opt
git clone ${repositorio} bmc-cms
chown -R ec2-user:ec2-user bmc-cms
cd bmc-cms

cat > .env <<'ENVFILE'
NODE_ENV=production
HOST=0.0.0.0
PORT=1337
APP_KEYS=${app_keys}
API_TOKEN_SALT=${api_token_salt}
ADMIN_JWT_SECRET=${admin_jwt}
JWT_SECRET=${jwt}
TRANSFER_TOKEN_SALT=${transfer_salt}
ENCRYPTION_KEY=${encryption_key}
DATABASE_CLIENT=postgres
DATABASE_URL=${database_url}
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=5
FRONTEND_URLS=${frontend_urls}
ENVFILE

chown ec2-user:ec2-user .env
chmod 600 .env

sudo -u ec2-user npm ci
sudo -u ec2-user npm run build

# --- Servicio ---------------------------------------------------------------
cat > /etc/systemd/system/bmc-cms.service <<'UNIT'
[Unit]
Description=BMC CMS (Strapi)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/bmc-cms
EnvironmentFile=/opt/bmc-cms/.env
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now bmc-cms
