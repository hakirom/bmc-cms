# Variables para el CMS en producción. Genere cada secreto con:
#   openssl rand -base64 32
# NUNCA los comparta por chat ni los suba al repositorio.

NODE_ENV=production
HOST=0.0.0.0
PORT=1337

# Secretos — distintos de los de desarrollo
APP_KEYS=cambiar1,cambiar2
API_TOKEN_SALT=cambiar
ADMIN_JWT_SECRET=cambiar
JWT_SECRET=cambiar
TRANSFER_TOKEN_SALT=cambiar
ENCRYPTION_KEY=cambiar

# ---- Base de datos (Neon) -----------------------------------------------
# Neon → Dashboard → Connection string. Ofrece dos endpoints:
#   · Pooled  (ep-xxx-pooler.<region>.aws.neon.tech)  → úselo en Vercel
#   · Directo (ep-xxx.<region>.aws.neon.tech)         → úselo en Render/VPS
# En serverless cada instancia abre conexiones propias; el pooled evita
# agotar el límite. Deje el sslmode=require que Neon incluye en la cadena.
#   postgresql://<usuario>:<clave>@ep-xxx-pooler.<region>.aws.neon.tech/<bd>?sslmode=require
DATABASE_CLIENT=postgres
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# En serverless cada instancia abre su propio pool: manténgalo pequeño para no
# agotar el límite de conexiones de Supabase. En un host persistente puede subirlo.
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=3

# ---- Front autorizado (CORS) --------------------------------------------
FRONTEND_URLS=https://tu-front.vercel.app

# Poner a true para no cargar el contenido de demostración
SEED_DISABLED=false
