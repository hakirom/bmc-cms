# Copie estas variables al panel del proveedor (Render, Railway, Fly, VPS…).
# Genere cada secreto con:  openssl rand -base64 32

NODE_ENV=production
HOST=0.0.0.0
PORT=1337

# Secretos — NO reutilice los de desarrollo
APP_KEYS=cambiar1,cambiar2
API_TOKEN_SALT=cambiar
ADMIN_JWT_SECRET=cambiar
JWT_SECRET=cambiar
TRANSFER_TOKEN_SALT=cambiar
ENCRYPTION_KEY=cambiar

# Base de datos: SQLite no sirve en hosting con disco efímero
DATABASE_CLIENT=postgres
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=bmc
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=true

# Dominios del front autorizados para llamar a la API (CORS)
FRONTEND_URLS=https://tu-front.vercel.app

# Poner a true si no quiere que el seed cargue el contenido de demostración
SEED_DISABLED=false
