{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/build",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/admin",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/api/index"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/_health",
      "destination": "/api/index"
    },
    {
      "source": "/i18n/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/content-manager/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/content-type-builder/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/upload/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/users-permissions/(.*)",
      "destination": "/api/index"
    }
  ]
}
