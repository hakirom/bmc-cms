{
  "kind": "collectionType",
  "collectionName": "plataformas",
  "info": {
    "singularName": "plataforma",
    "pluralName": "plataformas",
    "displayName": "Plataforma",
    "description": "Plataformas de la BMC: negociación, registro, liquidación, datos y programas"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 120,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "descripcion": {
      "type": "text",
      "required": true,
      "maxLength": 500,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "icono": {
      "type": "enumeration",
      "enum": [
        "exchange",
        "clipboard",
        "scale",
        "chart",
        "sprout"
      ],
      "default": "exchange",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "orden": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "activa": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "requiereSesion": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "resumenDemo": {
      "type": "text",
      "maxLength": 600,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "caracteristicas": {
      "type": "component",
      "repeatable": true,
      "component": "shared.punto",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
